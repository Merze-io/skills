{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.agentskills.io/discovery/0.2.0/schema.json",
  "title": "Agent Skills discovery index v0.2.0",
  "type": "object",
  "additionalProperties": true,
  "required": ["$schema", "skills"],
  "properties": {
    "$schema": {
      "type": "string",
      "const": "https://schemas.agentskills.io/discovery/0.2.0/schema.json"
    },
    "skills": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": ["name", "type", "description", "url", "digest"],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
          },
          "type": {
            "type": "string",
            "enum": ["skill-md", "archive"]
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          },
          "url": {
            "type": "string",
            "minLength": 1
          },
          "digest": {
            "type": "string",
            "pattern": "^sha256:[a-f0-9]{64}$"
          }
        }
      }
    }
  }
}
