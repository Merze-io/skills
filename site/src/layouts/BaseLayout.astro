---
import rethinkWoff2 from "@fontsource/rethink-sans/files/rethink-sans-latin-400-normal.woff2?url";
import "../styles/global.css";

interface Props {
  title: string;
  description?: string;
  canonicalPath?: string;
}

const {
  title,
  description = "Public Agent Skills from Merze — install into ChatGPT, Claude, Cursor, Claude Code, and other skill-capable agents.",
  canonicalPath = "/",
} = Astro.props;

const canonical = new URL(canonicalPath, Astro.site).href;
const pageTitle =
  title === "Skills" ? "Merze Agent Skills" : `${title} · Merze Agent Skills`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#112E51" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.png" type="image/png" />
    <link
      rel="preload"
      href={rethinkWoff2}
      as="font"
      type="font/woff2"
      crossorigin
    />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content={new URL("/favicon.png", Astro.site).href} />
    <meta name="twitter:card" content="summary" />
    <title>{pageTitle}</title>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header">
      <div class="site-header__inner">
        <a class="brand" href="/">
          <img
            class="brand__mark"
            src="/merze-mark.png"
            alt=""
            width="28"
            height="30"
          />
          <span class="brand__word">MERZE</span>
          <span class="brand__label">Skills</span>
        </a>
        <nav class="site-nav" aria-label="Primary">
          <a href="/" aria-current={canonicalPath === "/" ? "page" : undefined}
            >Catalog</a
          >
          <a
            href="/install"
            aria-current={canonicalPath === "/install" ? "page" : undefined}
            >Install</a
          >
          <a
            href="/about"
            aria-current={canonicalPath === "/about" ? "page" : undefined}
            >About</a
          >
          <a href="https://merze.ai" rel="noopener noreferrer">merze.ai</a>
        </nav>
      </div>
    </header>
    <main id="main" class="site-main">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="site-footer__inner">
        <p>
          Public Agent Skills for
          <a href="https://merze.ai">Merze</a>
          — ChatGPT, Claude, Cursor, Claude Code, and more.
        </p>
        <p>
          <a href="/install">Install</a>
          ·
          <a href="/skills.json">skills.json</a>
          ·
          <a href="/sitemap-index.xml">Sitemap</a>
        </p>
      </div>
    </footer>
  </body>
</html>
