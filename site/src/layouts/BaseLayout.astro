---
import rethinkWoff2 from "@fontsource/rethink-sans/files/rethink-sans-latin-400-normal.woff2?url";
import "../styles/global.css";
import JsonLd from "../components/JsonLd.astro";
import { absolute } from "../lib/routes";
import { buildSiteGraph } from "../lib/seo.mjs";

interface Props {
  title: string;
  description?: string;
  canonicalPath?: string;
  socialImage?: string;
  socialImageAlt?: string;
  socialImageWidth?: number;
  socialImageHeight?: number;
  structuredData?: Record<string, unknown>[];
}

const {
  title,
  description = "Specialized AI skills for US taxation, accounting, business compliance and financial operations. Download and use domain-specific expertise with your AI assistant.",
  canonicalPath = "/",
  socialImage = "/social/merze-skills-v1.png",
  socialImageAlt = "Merze Skills — public Agent Skills",
  socialImageWidth = 1200,
  socialImageHeight = 630,
  structuredData = [],
} = Astro.props;

const SITE_NAME = "US Tax & Accounting Intelligence";
const canonical = absolute(canonicalPath);
const socialImageUrl = absolute(socialImage);
const jsonLd = buildSiteGraph({ siteUrl: absolute("/"), nodes: structuredData });
const pageTitle = title === "Skills" ? SITE_NAME : `${title} · ${SITE_NAME}`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#112E51" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.png" type="image/png" />
    <link
      rel="preload"
      href={rethinkWoff2}
      as="font"
      type="font/woff2"
      crossorigin
    />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:image" content={socialImageUrl} />
    <meta property="og:image:width" content={String(socialImageWidth)} />
    <meta property="og:image:height" content={String(socialImageHeight)} />
    <meta property="og:image:alt" content={socialImageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImageUrl} />
    <meta name="twitter:image:alt" content={socialImageAlt} />
    <JsonLd data={jsonLd} />
    <title>{pageTitle}</title>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header">
      <div class="site-header__inner">
        <a class="brand" href="/">
          <img
            class="brand__mark"
            src="/merze-mark.png"
            alt=""
            width="28"
            height="30"
          />
          <span class="brand__word">MERZE</span>
          <span class="brand__label">Skills</span>
        </a>
        <nav class="site-nav" aria-label="Primary">
          <a href="/" aria-current={canonicalPath === "/" ? "page" : undefined}
            >Catalog</a
          >
          <a
            href="/about"
            aria-current={canonicalPath === "/about" ? "page" : undefined}
            >About</a
          >
          <a href="https://merze.ai" rel="noopener noreferrer">merze.ai</a>
        </nav>
      </div>
    </header>
    <main id="main" class="site-main">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="site-footer__inner">
        <p>
          Public Agent Skills for
          <a href="https://merze.ai">Merze</a>
          — ChatGPT, Claude, and more.
        </p>
        <p>
          <a href="/skills.json">skills.json</a>
          ·
          <a href="/sitemap-index.xml">Sitemap</a>
        </p>
      </div>
    </footer>
    <script is:inline>
      // The site serves production and staging from one static build. Every
      // copied command and prompt must use the host the visitor is on, so a
      // staging copy reads staging files and a production copy reads
      // production files. Canonical metadata and downloadable manifests keep
      // the production origin.
      (() => {
        const canonical = "https://skills.merze.ai/";
        const origin = window.location.origin;
        if (origin === "https://skills.merze.ai") return;
        const localize = (text) => text.split(canonical).join(`${origin}/`);
        for (const link of document.querySelectorAll("a.chat-link[href]")) {
          let url;
          try {
            url = new URL(link.getAttribute("href"), origin);
          } catch {
            continue;
          }
          const prompt = url.searchParams.get("q");
          if (!prompt || !prompt.includes(canonical)) continue;
          url.search = "?q=" + encodeURIComponent(localize(prompt));
          link.setAttribute("href", url.toString());
        }
        for (const code of document.querySelectorAll("pre code")) {
          const text = code.textContent || "";
          if (!text.includes(canonical)) continue;
          code.textContent = localize(text);
        }
        for (const button of document.querySelectorAll("button[data-copy]")) {
          const text = button.getAttribute("data-copy") || "";
          if (!text.includes(canonical)) continue;
          button.setAttribute("data-copy", localize(text));
        }
      })();
    </script>
  </body>
</html>
