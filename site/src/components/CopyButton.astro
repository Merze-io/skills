---
import Icon from "./Icon.astro";

interface Props {
  text?: string;
  url?: string;
  label?: string;
}

const { text = "", url, label = "Copy" } = Astro.props;
---

<button
  type="button"
  class="btn btn--secondary btn--sm copy-btn"
  data-copy={text || undefined}
  data-copy-url={url || undefined}
  aria-label={label}
>
  <span class="copy-btn__idle">
    <Icon name="copy" size={16} />
    {label}
  </span>
  <span class="copy-btn__done" hidden>
    <Icon name="check" size={16} />
    Copied
  </span>
</button>

<script>
  async function resolveCopyValue(btn: HTMLButtonElement): Promise<string> {
    const direct = btn.dataset.copy;
    if (direct) return direct;
    const url = btn.dataset.copyUrl;
    if (!url) return "";
    const res = await fetch(url);
    if (!res.ok) throw new Error("download failed");
    return await res.text();
  }

  function bindCopyButtons() {
    document.querySelectorAll<HTMLButtonElement>("[data-copy], [data-copy-url]").forEach((btn) => {
      if (btn.dataset.bound) return;
      btn.dataset.bound = "1";
      btn.addEventListener("click", async () => {
        let value = "";
        try {
          value = await resolveCopyValue(btn);
          await navigator.clipboard.writeText(value);
        } catch {
          try {
            if (!value) value = await resolveCopyValue(btn);
          } catch {
            return;
          }
          const ta = document.createElement("textarea");
          ta.value = value;
          document.body.appendChild(ta);
          ta.select();
          document.execCommand("copy");
          ta.remove();
        }
        const idle = btn.querySelector<HTMLElement>(".copy-btn__idle");
        const done = btn.querySelector<HTMLElement>(".copy-btn__done");
        if (idle && done) {
          idle.hidden = true;
          done.hidden = false;
          window.setTimeout(() => {
            idle.hidden = false;
            done.hidden = true;
          }, 1600);
        }
      });
    });
  }
  bindCopyButtons();
  document.addEventListener("astro:page-load", bindCopyButtons);
</script>
