---

<div class="pagefind-mount" data-pagefind-mount></div>

<script is:inline>
  (function () {
    function loadCss(href) {
      if (document.querySelector('link[href="' + href + '"]')) return;
      var link = document.createElement("link");
      link.rel = "stylesheet";
      link.href = href;
      document.head.appendChild(link);
    }

    function mountPagefind() {
      var host = document.querySelector("[data-pagefind-mount]");
      if (!host || host.querySelector(".pagefind-ui")) return;
      loadCss("/pagefind/pagefind-ui.css");
      var script = document.createElement("script");
      script.src = "/pagefind/pagefind-ui.js";
      script.onload = function () {
        if (!window.PagefindUI) return;
        new window.PagefindUI({
          element: host,
          showImages: false,
          showSubResults: true,
          resetStyles: false,
        });
        var input = host.querySelector(".pagefind-ui__search-input");
        if (input) {
          input.setAttribute("aria-label", "Search skills with Pagefind");
          if (!input.id) input.id = "pagefind-search";
          if (!host.querySelector('label[for="pagefind-search"]')) {
            var label = document.createElement("label");
            label.className = "sr-only";
            label.htmlFor = "pagefind-search";
            label.textContent = "Search skills with Pagefind";
            host.insertBefore(label, host.firstChild);
          }
        }
      };
      script.onerror = function () {
        /* Pagefind assets missing until after build */
      };
      document.body.appendChild(script);
    }

    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", mountPagefind);
    } else {
      mountPagefind();
    }
  })();
</script>

<style is:global>
  .pagefind-mount {
    margin-bottom: 1.5rem;
  }
  .pagefind-ui {
    --pagefind-ui-scale: 0.9;
    --pagefind-ui-primary: #112e51;
    --pagefind-ui-text: #212121;
    --pagefind-ui-background: #ffffff;
    --pagefind-ui-border: #e5e7eb;
    --pagefind-ui-tag: #fafbff;
    --pagefind-ui-border-width: 1px;
    --pagefind-ui-border-radius: 1rem;
    --pagefind-ui-font: "Inter Variable", Inter, system-ui, sans-serif;
  }
  .pagefind-ui .pagefind-ui__search-input {
    font-weight: 500;
  }
  .pagefind-ui .pagefind-ui__result-link {
    color: #112e51;
  }
</style>
