---
---

<div class="pagefind-search" data-pagefind-root>
  <label class="pagefind-search__label" id="pagefind-search-label" for="pagefind-search-trigger">
    Search skills
  </label>
  <button
    type="button"
    id="pagefind-search-trigger"
    class="pagefind-search__trigger"
    data-pagefind-trigger
    aria-labelledby="pagefind-search-label"
  >
    Search skills…
  </button>
  <div class="pagefind-mount" data-pagefind-mount hidden></div>
</div>

<script is:inline>
  (function () {
    var loaded = false;

    function loadCss(href) {
      if (document.querySelector('link[href="' + href + '"]')) return null;
      var link = document.createElement("link");
      link.rel = "stylesheet";
      link.href = href;
      document.head.appendChild(link);
      return link;
    }

    function wireLabel(input) {
      var label = document.getElementById("pagefind-search-label");
      if (!label || !input) return;
      input.id = "pagefind-search";
      input.setAttribute("aria-labelledby", "pagefind-search-label");
      input.removeAttribute("aria-label");
      label.setAttribute("for", "pagefind-search");
    }

    function hideTrigger(trigger) {
      if (!trigger) return;
      trigger.hidden = true;
      trigger.setAttribute("aria-hidden", "true");
      trigger.tabIndex = -1;
    }

    function mountPagefind() {
      var host = document.querySelector("[data-pagefind-mount]");
      var trigger = document.querySelector("[data-pagefind-trigger]");
      if (!host || host.querySelector(".pagefind-ui")) {
        if (host) host.hidden = false;
        hideTrigger(trigger);
        var existing = host && host.querySelector(".pagefind-ui__search-input");
        if (existing) {
          wireLabel(existing);
          existing.focus();
        }
        return;
      }
      if (loaded) return;
      loaded = true;
      var pagefindCss = loadCss("/pagefind/pagefind-ui.css");
      var script = document.createElement("script");
      script.src = "/pagefind/pagefind-ui.js";
      script.onload = function () {
        if (!window.PagefindUI) {
          loaded = false;
          return;
        }
        new window.PagefindUI({
          element: host,
          showImages: false,
          showSubResults: true,
          resetStyles: false,
          translations: {
            placeholder: "Search skills…",
            zero_results:
              "No skills match “[SEARCH_TERM]”. Try “LLC” or clear the query.",
          },
        });
        var input = host.querySelector(".pagefind-ui__search-input");
        if (!input) {
          loaded = false;
          return;
        }
        host.hidden = false;
        hideTrigger(trigger);
        wireLabel(input);
        if (pagefindCss) {
          pagefindCss.addEventListener("load", function () {
            var override = document.getElementById("pagefind-placeholder-override");
            if (override) document.head.appendChild(override);
          });
        }
        var override = document.getElementById("pagefind-placeholder-override");
        if (override) document.head.appendChild(override);
        input.focus();
      };
      script.onerror = function () {
        loaded = false;
      };
      document.body.appendChild(script);
    }

    function bind() {
      var trigger = document.querySelector("[data-pagefind-trigger]");
      if (!trigger || trigger.dataset.bound) return;
      trigger.dataset.bound = "1";
      trigger.addEventListener("click", mountPagefind);
      trigger.addEventListener("focus", mountPagefind);
    }

    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", bind);
    } else {
      bind();
    }
    document.addEventListener("astro:page-load", bind);
  })();
</script>

<style is:global>
  .pagefind-search {
    margin-bottom: 0;
  }
  .pagefind-search__label {
    display: block;
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--color-muted-strong);
    margin-bottom: 0.4rem;
  }
  .pagefind-search__trigger {
    display: block;
    width: 100%;
    text-align: left;
    height: 2.75rem;
    padding: 0 1rem;
    border: 1px solid var(--color-border);
    border-radius: 0.75rem;
    background: var(--color-bg-elevated);
    color: var(--color-muted);
    font: inherit;
    font-size: 0.9375rem;
    font-weight: 500;
    cursor: text;
    transition: border-color var(--motion) var(--ease-out);
  }
  /* Author display:block would otherwise defeat the HTML hidden attribute */
  .pagefind-search__trigger[hidden] {
    display: none !important;
  }
  .pagefind-search__trigger:hover {
    border-color: var(--color-border-strong);
  }
  .pagefind-search__trigger:focus-visible {
    outline: 2px solid var(--focus-ring);
    outline-offset: 2px;
  }
  .pagefind-mount {
    margin-top: 0;
  }
  .pagefind-mount[hidden] {
    display: none !important;
  }
  .pagefind-ui {
    --pagefind-ui-scale: 0.65;
    --pagefind-ui-primary: #112e51;
    --pagefind-ui-text: #1a2332;
    --pagefind-ui-background: #ffffff;
    --pagefind-ui-border: #d7e0ec;
    --pagefind-ui-tag: #f3f6fb;
    --pagefind-ui-border-width: 1px;
    --pagefind-ui-border-radius: 0.75rem;
    --pagefind-ui-font: "Rethink Sans", system-ui, sans-serif;
  }
  /* Keep active field the same compact size as the trigger */
  .pagefind-search .pagefind-ui .pagefind-ui__form:before {
    width: 1rem;
    height: 1rem;
    top: 50%;
    left: 0.85rem;
    transform: translateY(-50%);
  }
  .pagefind-search .pagefind-ui input.pagefind-ui__search-input {
    height: 2.75rem;
    min-height: 2.75rem;
    padding: 0 2.5rem 0 2.5rem;
    font-size: 0.9375rem;
    font-weight: 500;
    line-height: 1.25;
    border-radius: 0.75rem;
  }
  .pagefind-search .pagefind-ui .pagefind-ui__search-clear {
    top: 50%;
    right: 0.25rem;
    transform: translateY(-50%);
    height: 2rem;
    padding: 0 0.65rem;
    font-size: 0.75rem;
  }
  .pagefind-search .pagefind-ui .pagefind-ui__drawer {
    gap: 1rem;
  }
  .pagefind-search .pagefind-ui .pagefind-ui__results-area {
    margin-top: 0.75rem;
  }
  .pagefind-search .pagefind-ui .pagefind-ui__message {
    padding: 0.5rem 0;
    font-size: 0.875rem;
    height: auto;
  }
  .pagefind-search .pagefind-ui .pagefind-ui__result {
    padding: 0.75rem 0;
  }
  .pagefind-ui .pagefind-ui__result-link {
    color: #112e51;
  }
</style>
<style is:inline id="pagefind-placeholder-override">
  .pagefind-search .pagefind-ui input.pagefind-ui__search-input::placeholder,
  .pagefind-search .pagefind-ui input.pagefind-ui__search-input::-webkit-input-placeholder {
    opacity: 1 !important;
    color: #5b6b7c !important;
  }
</style>
