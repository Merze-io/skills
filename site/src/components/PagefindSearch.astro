---
---

<div class="pagefind-search" data-pagefind-root>
  <label class="pagefind-search__label" for="pagefind-search-trigger">
    Search skills
  </label>
  <button
    type="button"
    id="pagefind-search-trigger"
    class="pagefind-search__trigger"
    data-pagefind-trigger
  >
    Search skills…
  </button>
  <div class="pagefind-mount" data-pagefind-mount hidden></div>
</div>

<script is:inline>
  (function () {
    var loaded = false;

    function loadCss(href) {
      if (document.querySelector('link[href="' + href + '"]')) return;
      var link = document.createElement("link");
      link.rel = "stylesheet";
      link.href = href;
      document.head.appendChild(link);
    }

    function mountPagefind() {
      var root = document.querySelector("[data-pagefind-root]");
      var host = document.querySelector("[data-pagefind-mount]");
      var trigger = document.querySelector("[data-pagefind-trigger]");
      if (!host || host.querySelector(".pagefind-ui")) {
        if (host) host.hidden = false;
        if (trigger) trigger.hidden = true;
        var existing = host && host.querySelector(".pagefind-ui__search-input");
        if (existing) existing.focus();
        return;
      }
      if (loaded) return;
      loaded = true;
      loadCss("/pagefind/pagefind-ui.css");
      var script = document.createElement("script");
      script.src = "/pagefind/pagefind-ui.js";
      script.onload = function () {
        if (!window.PagefindUI) return;
        host.hidden = false;
        if (trigger) trigger.hidden = true;
        new window.PagefindUI({
          element: host,
          showImages: false,
          showSubResults: true,
          resetStyles: false,
          translations: {
            placeholder: "Search skills…",
            zero_results: "No skills match “[SEARCH_TERM]”. Try “LLC” or clear the query.",
          },
        });
        var input = host.querySelector(".pagefind-ui__search-input");
        if (input) {
          input.id = "pagefind-search";
          input.setAttribute("aria-label", "Search skills");
          input.focus();
        }
      };
      script.onerror = function () {
        loaded = false;
      };
      document.body.appendChild(script);
    }

    function bind() {
      var trigger = document.querySelector("[data-pagefind-trigger]");
      if (!trigger || trigger.dataset.bound) return;
      trigger.dataset.bound = "1";
      trigger.addEventListener("click", mountPagefind);
      trigger.addEventListener("focus", mountPagefind);
    }

    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", bind);
    } else {
      bind();
    }
    document.addEventListener("astro:page-load", bind);
  })();
</script>

<style is:global>
  .pagefind-search {
    margin-bottom: 1.5rem;
  }
  .pagefind-search__label {
    display: block;
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--color-muted-strong);
    margin-bottom: 0.35rem;
  }
  .pagefind-search__trigger {
    display: block;
    width: 100%;
    text-align: left;
    padding: 0.875rem 1rem;
    border: 1px solid var(--color-border);
    border-radius: 1rem;
    background: #fff;
    color: #64748b;
    font: inherit;
    font-weight: 500;
    cursor: text;
    box-shadow: var(--shadow-soft);
  }
  .pagefind-search__trigger:focus-visible {
    outline: 2px solid var(--focus-ring);
    outline-offset: 2px;
  }
  .pagefind-mount {
    margin-top: 0;
  }
  .pagefind-ui {
    --pagefind-ui-scale: 0.9;
    --pagefind-ui-primary: #112e51;
    --pagefind-ui-text: #212121;
    --pagefind-ui-background: #ffffff;
    --pagefind-ui-border: #e5e7eb;
    --pagefind-ui-tag: #fafbff;
    --pagefind-ui-border-width: 1px;
    --pagefind-ui-border-radius: 1rem;
    --pagefind-ui-font: "Inter Variable", Inter, system-ui, sans-serif;
  }
  .pagefind-ui .pagefind-ui__search-input {
    font-weight: 500;
  }
  /* Override Pagefind's 0.2 opacity placeholder (~1.3:1) → ≥4.5:1 */
  .pagefind-ui .pagefind-ui__search-input::placeholder {
    opacity: 1;
    color: #64748b;
  }
  .pagefind-ui .pagefind-ui__result-link {
    color: #112e51;
  }
</style>
