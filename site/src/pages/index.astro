---
import BaseLayout from "../layouts/BaseLayout.astro";
import PagefindSearch from "../components/PagefindSearch.astro";
import SkillFilters from "../components/SkillFilters.astro";
import { getSkillListItems } from "../lib/skills";
import { absolute, skillPath } from "../lib/routes";
import { buildCollectionPage } from "../lib/seo.mjs";
import { getPageSeo } from "../lib/supporting-metadata";

const skills = await getSkillListItems();
const skillCount = skills.length;
const description = getPageSeo("/").description;
const structuredData = buildCollectionPage({
  siteUrl: absolute("/"),
  url: absolute("/"),
  name: "Merze Skills",
  description,
  skills: skills.map((skill) => ({ name: skill.title, url: absolute(skillPath(skill.slug)) })),
});

const agents = ["ChatGPT", "Claude", "Cursor", "Claude Code"] as const;
---

<BaseLayout
  title="Skills"
  description={description}
  canonicalPath="/"
  structuredData={structuredData}
>
  <section class="hero" aria-labelledby="hero-heading">
    <h1 id="hero-heading" class="hero__title">Merze Skills<span class="hero__period" aria-hidden="true">.</span></h1>
    <p class="hero__lede">
      Public Agent Skills for formation, compliance, and operations. Each skill
      is a folder you can download, read, and install — no account, no runtime,
      no lock-in.
    </p>
    <ul class="agent-chips" aria-label="Works with">
      {
        agents.map((name) => (
          <li>
            <span class="agent-chip">{name}</span>
          </li>
        ))
      }
    </ul>
    <p class="hero__meta">
      <span class="hero__count">{skillCount}</span>
      {skillCount === 1 ? " skill" : " skills"} available
    </p>
  </section>

  <div class="catalog-toolbar" id="catalog">
    <PagefindSearch />
  </div>

  <div class="catalog">
    <h2 class="catalog__title">Catalog</h2>
    <SkillFilters skills={skills} />
  </div>

  <section class="prose how-this-works" aria-labelledby="how-heading">
    <h2 id="how-heading">What is an Agent Skill?</h2>
    <p>
      An Agent Skill is a folder of instructions that an AI agent loads when a
      task matches it. The folder has a <code>SKILL.md</code> file — YAML
      frontmatter plus markdown steps — and optional supporting files such as a
      data table or a reference sheet.
    </p>
    <p>
      Skills here are plain text. You can open every file before you install it,
      diff two versions, or keep a copy in your own repository. Nothing in this
      catalog phones home or runs code on your behalf.
    </p>

    <h2 id="use-heading">How do you use one?</h2>
    <ol>
      <li>Open a skill and read its <code>SKILL.md</code>.</li>
      <li>
        Install it with <code>npx skills add</code>, or download the files into
        your agent's skills directory.
      </li>
      <li>Reload the agent so it discovers the skill, then ask a question that matches it.</li>
    </ol>
    <p>
      Full steps, including the paste-for-chat-agents option, are on the
      <a href="/about">About page</a>.
    </p>
  </section>
</BaseLayout>
