---
import BaseLayout from "../layouts/BaseLayout.astro";
import PagefindSearch from "../components/PagefindSearch.astro";
import SkillFilters from "../components/SkillFilters.astro";
import { getSkillListItems } from "../lib/skills";

const skills = await getSkillListItems();
const skillCount = skills.length;
---

<BaseLayout
  title="Skills"
  description="Browse and download public Agent Skills from Merze — ready for coding agents."
  canonicalPath="/"
>
  <section class="hero" aria-labelledby="hero-heading">
    <h1 id="hero-heading" class="hero__title">Merze Skills</h1>
    <p class="hero__lede">
      Install-ready agent skills for formation, compliance, and ops. Search,
      then download every file in a skill from this site.
    </p>
    <p class="hero__meta">
      <span class="hero__count">{skillCount}</span>
      {skillCount === 1 ? " skill" : " skills"} available
    </p>
  </section>

  <div class="catalog-toolbar" id="catalog">
    <PagefindSearch />
  </div>

  <div class="catalog">
    <h2 class="sr-only">All skills</h2>
    <SkillFilters skills={skills} />
  </div>
</BaseLayout>
