---
import { render } from "astro:content";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import CopyButton from "../../../components/CopyButton.astro";
import Icon from "../../../components/Icon.astro";
import {
  displayTitle,
  extractWhenToUseFromBody,
  getAllSkills,
  getPublishedSkillFiles,
  getSkillUpdatedAt,
  getSupportingFiles,
  parseDescription,
  shellSingleQuote,
  skillFileUrl,
  skillSlug,
  supportingFileSlug,
  formatUpdated,
} from "../../../lib/skills";
import { SITE_ORIGIN, skillDocPath, skillPath } from "../../../lib/routes";
import { extractToc } from "../../../lib/toc";

export async function getStaticPaths() {
  const skills = await getAllSkills();
  return skills.map((skill) => ({
    params: { name: skillSlug(skill) },
    props: { skill },
  }));
}

const { skill } = Astro.props;
const slug = skillSlug(skill);
const title = displayTitle(skill);
const parts = parseDescription(skill.data.description);
const { Content } = await render(skill);
const body = skill.body ?? "";
const whenFromBody =
  parts.useWhen.length === 0 ? extractWhenToUseFromBody(body) : null;
const toc = extractToc(body);
const supporting = await getSupportingFiles(slug);
const publishedFiles = getPublishedSkillFiles(slug);
const updatedAt = getSkillUpdatedAt(slug);
const updated = formatUpdated(updatedAt);
const version = skill.data.metadata?.version ?? null;
const tags = skill.data.metadata?.tags ?? [];
const category = skill.data.metadata?.category ?? null;

const publishedForPaste = [...publishedFiles].sort((a, b) => {
  if (a.relativePath === "SKILL.md") return -1;
  if (b.relativePath === "SKILL.md") return 1;
  return a.relativePath.localeCompare(b.relativePath, "en");
});

// curl --create-dirs makes the initial mkdir -p redundant
const installSnippet = publishedFiles
  .map((f) => {
    const localPath = `${slug}/${f.relativePath}`;
    const url = `${SITE_ORIGIN}${skillFileUrl(slug, f.relativePath)}`;
    return `curl --create-dirs -fsSLo ${shellSingleQuote(localPath)} ${shellSingleQuote(url)}`;
  })
  .join(" && \\\n");

const chatAgentFileLines = publishedForPaste
  .map((f) => `- ${SITE_ORIGIN}${skillFileUrl(slug, f.relativePath)}`)
  .join("\n");
const chatAgentPaste = [
  "Read these Merze skill files and follow them for this chat:",
  "",
  chatAgentFileLines,
  "",
  "Treat SKILL.md as the instructions. Use supporting files only when the skill says to.",
].join("\n");
---

<BaseLayout
  title={title}
  description={parts.summary}
  canonicalPath={skillPath(slug)}
>
  <article data-pagefind-body class="skill-detail">
    <header class="skill-detail__header">
      <p class="back-row">
        <a href="/" class="back-link">
          <Icon name="arrow-left" size={16} />
          All skills
        </a>
      </p>
      <h1>{title}</h1>
      <p class="skill-detail__id"><code>{skill.data.name}</code></p>
      <p class="lede">{parts.summary}</p>
      <div class="skill-meta">
        {version && <span class="badge">v{version}</span>}
        {category && <span class="badge badge--soft">{category}</span>}
        {
          tags.map((tag) => (
            <span class="badge badge--soft">{tag}</span>
          ))
        }
        {
          updated && updatedAt && (
            <span>
              Updated <time datetime={updatedAt}>{updated}</time>
            </span>
          )
        }
      </div>
    </header>

    {
      (parts.useWhen.length > 0 ||
        parts.notFor.length > 0 ||
        whenFromBody) && (
        <section class="panel" aria-labelledby="when-heading">
          <h2 class="panel__title" id="when-heading">
            When to use
          </h2>
          {parts.useWhen.length > 0 ? (
            <ul>
              {parts.useWhen.map((s) => (
                <li>{s}</li>
              ))}
            </ul>
          ) : whenFromBody ? (
            <p>{whenFromBody}</p>
          ) : parts.fallbackFull ? (
            <p>{parts.fallbackFull}</p>
          ) : null}
          {parts.notFor.length > 0 && (
            <>
              <p class="panel__title" style="margin-top:1rem">
                Not for
              </p>
              <ul>
                {parts.notFor.map((s) => (
                  <li>{s}</li>
                ))}
              </ul>
            </>
          )}
        </section>
      )
    }

    <section class="panel panel--install" aria-labelledby="install-heading">
      <h2 class="panel__title" id="install-heading">Install</h2>
      <p class="panel__copy">
        Download every file in this skill and place them under
        <code>{slug}/</code> in your agent’s skills directory.
      </p>
      <ul class="file-list file-list--install">
        {
          publishedFiles.map((file) => (
            <li>
              <a href={skillFileUrl(slug, file.relativePath)} download>
                <Icon name="download" size={14} />
                {file.relativePath}
              </a>
              <span class="file-list__actions">
                <CopyButton
                  url={skillFileUrl(slug, file.relativePath)}
                  label={`Copy ${file.relativePath}`}
                />
              </span>
            </li>
          ))
        }
      </ul>
      <div class="install-method">
        <h3 class="install-method__title" id="chat-agents-heading">
          Chat agents
        </h3>
        <p class="panel__copy">
          Paste into ChatGPT, Claude, or another chat agent so it can open the
          skill files from this catalog.
        </p>
        <div class="install-snippet">
          <pre tabindex="0"><code>{chatAgentPaste}</code></pre>
          <CopyButton text={chatAgentPaste} label="Copy for chat agents" />
        </div>
      </div>
      <div class="install-method">
        <h3 class="install-method__title" id="cli-install-heading">
          Skills directory
        </h3>
        <p class="panel__copy">
          Or download into a local <code>{slug}/</code> folder with curl.
        </p>
        <div class="install-snippet">
          <pre tabindex="0"><code>{installSnippet}</code></pre>
          <CopyButton text={installSnippet} label="Copy install command" />
        </div>
      </div>
    </section>

    {
      supporting.length > 0 && (
        <section class="panel" aria-labelledby="files-heading">
          <h2 class="panel__title" id="files-heading">
            Supporting files
          </h2>
          <ul class="file-list">
            {supporting.map((file) => {
              const fileSlug = supportingFileSlug(file);
              return (
                <li>
                  <a href={skillDocPath(slug, fileSlug)}>
                    <Icon name="file" size={14} />
                    {fileSlug}.md
                  </a>
                  <a
                    class="file-list__download"
                    href={skillFileUrl(slug, `${fileSlug}.md`)}
                    download
                  >
                    <Icon name="download" size={14} />
                    <span class="sr-only">Download {fileSlug}.md</span>
                  </a>
                </li>
              );
            })}
          </ul>
        </section>
      )
    }

    <div class="layout-detail skill-detail__body">
      <div class="prose">
        <Content />
      </div>
      {
        toc.length > 0 && (
          <aside class="toc" aria-labelledby="toc-heading">
            <p class="toc__title" id="toc-heading">
              On this page
            </p>
            <nav>
              <ol>
                {toc.map((item) => (
                  <li class={`toc-depth-${item.depth}`}>
                    <a href={`#${item.id}`}>{item.text}</a>
                  </li>
                ))}
              </ol>
            </nav>
          </aside>
        )
      }
    </div>
  </article>
</BaseLayout>

<script>
  document.querySelectorAll(".prose table").forEach((table) => {
    if (table.parentElement?.classList.contains("table-wrap")) return;
    const wrap = document.createElement("div");
    wrap.className = "table-wrap";
    wrap.tabIndex = 0;
    table.parentElement?.insertBefore(wrap, table);
    wrap.appendChild(table);
  });
</script>
