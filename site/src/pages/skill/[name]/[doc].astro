---
import { render } from "astro:content";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import Icon from "../../../components/Icon.astro";
import {
  displayTitle,
  getAllSkills,
  getSupportingFiles,
  skillFileUrl,
  skillSlug,
  supportingFileSlug,
} from "../../../lib/skills";
import { absolute, skillDocPath, skillPath } from "../../../lib/routes";
import { extractToc } from "../../../lib/toc";
import { buildSupportingPage, socialImageForSkill } from "../../../lib/seo.mjs";
import { getSupportingMetadata } from "../../../lib/supporting-metadata";

export async function getStaticPaths() {
  const skills = await getAllSkills();
  const paths = [];
  for (const skill of skills) {
    const slug = skillSlug(skill);
    const files = await getSupportingFiles(slug);
    for (const file of files) {
      const fileSlug = supportingFileSlug(file);
      paths.push({
        params: { name: slug, doc: fileSlug },
        props: { skill, supporting: file, fileSlug },
      });
    }
  }
  return paths;
}

const { skill, supporting, fileSlug } = Astro.props;
const slug = skillSlug(skill);
const skillTitle = displayTitle(skill);
const { Content } = await render(supporting);
const toc = extractToc(supporting.body ?? "");
const canonicalPath = skillDocPath(slug, fileSlug);
const filename = `${fileSlug}.md`;
const { title, description } = getSupportingMetadata({
  canonicalPath,
  body: supporting.body ?? "",
  filename,
  skillTitle,
});
const downloadUrl = skillFileUrl(slug, filename);
const structuredData = buildSupportingPage({
  siteUrl: absolute("/"),
  url: absolute(canonicalPath),
  name: title,
  description,
  parentUrl: absolute(skillPath(slug)),
  breadcrumbs: [
    { name: "Catalog", url: absolute("/") },
    { name: skillTitle, url: absolute(skillPath(slug)) },
    { name: title, url: absolute(canonicalPath) },
  ],
});
---

<BaseLayout
  title={title}
  description={description}
  canonicalPath={canonicalPath}
  structuredData={structuredData}
  {...socialImageForSkill(slug)}
>
  <article data-pagefind-body class="skill-detail">
    <p class="back-row">
      <a href={skillPath(slug)} class="back-link">
        <Icon name="arrow-left" size={16} />
        {skillTitle}
      </a>
    </p>
    <header class="skill-detail__header">
      <h1>{title}</h1>
      <p class="lede">{description}</p>
      <div class="skill-meta">
        <a class="btn btn--secondary btn--sm" href={downloadUrl} download>
          <Icon name="download" size={16} />
          Download {filename}
        </a>
      </div>
    </header>

    <div class="layout-detail">
      <div class="prose">
        <Content />
      </div>
      {
        toc.length > 0 && (
          <aside class="toc" aria-labelledby="toc-heading">
            <p class="toc__title" id="toc-heading">
              On this page
            </p>
            <nav>
              <ol>
                {toc.map((item) => (
                  <li class={`toc-depth-${item.depth}`}>
                    <a href={`#${item.id}`}>{item.text}</a>
                  </li>
                ))}
              </ol>
            </nav>
          </aside>
        )
      }
    </div>
  </article>
</BaseLayout>

<script>
  document.querySelectorAll(".prose table").forEach((table) => {
    if (table.parentElement?.classList.contains("table-wrap")) return;
    const wrap = document.createElement("div");
    wrap.className = "table-wrap";
    wrap.tabIndex = 0;
    table.parentElement?.insertBefore(wrap, table);
    wrap.appendChild(table);
  });
</script>
